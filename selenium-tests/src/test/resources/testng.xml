<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Innovation Engine Test Suite" verbose="1" parallel="false">
    
    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl" value="http://localhost:5000"/>
    
    <listeners>
        <listener class-name="com.innovationengine.listeners.TestListener"/>
        <listener class-name="com.innovationengine.listeners.ExtentReportListener"/>
    </listeners>
    
    <test name="SPOC Dashboard Tests - RBTES-1035">
        <classes>
            <class name="com.innovationengine.tests.SPOCDashboardTest"/>
        </classes>
    </test>
    
    <test name="SPOC Dashboard POM Tests">
        <classes>
            <class name="com.innovationengine.tests.SPOCDashboardPOMTest"/>
        </classes>
    </test>
    
</suite>